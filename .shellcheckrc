# Переменные конфига и цвета объявлены в lib/common.sh, а используются в других модулях.
disable=SC2034,SC2154
# _chk/ok/info всегда возвращают 0, поэтому «A && B || C» в doctor безопасно.
disable=SC2015
# local x=$(…) для строк, где код возврата не важен.
disable=SC2155
# sed по ESC-последовательностям нагляднее, чем ${//}.
disable=SC2001
external-sources=true
