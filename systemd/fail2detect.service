[Unit]
Description=fail2detect — защита Remnawave (фаервол + бан-движок)
Documentation=https://github.com/fail2detect/fail2detect
After=network-online.target nftables.service ufw.service docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/fail2detect fw apply
ExecStart=/usr/local/bin/fail2detect daemon
Restart=always
RestartSec=5
KillMode=control-group
Environment=NO_COLOR=1

[Install]
WantedBy=multi-user.target
